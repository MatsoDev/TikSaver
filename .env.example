# Postgres (Neon) connection string. Use the pooled connection string for the app.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# Password for the single-user admin UI.
ADMIN_PASSWORD="change-me"

# 32 random bytes, base64 encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Shared secret checked by GET /api/tick (header: x-cron-secret).
CRON_SECRET="change-me"

# Fine-grained GitHub token with Actions:write on GITHUB_REPO, used to dispatch the worker.
GITHUB_TOKEN=""
GITHUB_REPO="MatsoDev/TikSaver"

# Telegram notifications.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
