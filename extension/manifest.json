{
  "manifest_version": 3,
  "name": "Tiksave Cookie Sync",
  "version": "1.1.0",
  "permissions": ["cookies", "alarms", "storage", "tabs"],
  "host_permissions": ["https://*.tiktok.com/*", "https://tiksaver-six.vercel.app/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "Tiksave cookie sync" }
}
